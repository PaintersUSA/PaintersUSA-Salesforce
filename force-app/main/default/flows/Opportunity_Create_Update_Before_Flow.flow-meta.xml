        </connector>
    </assignments>
    <assignments>
        <name>Set_procore_due_date</name>
        <label>Set procore due date</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Estimate_Due_Date__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>procoreDueDate</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_related_account</targetReference>
        </connector>
