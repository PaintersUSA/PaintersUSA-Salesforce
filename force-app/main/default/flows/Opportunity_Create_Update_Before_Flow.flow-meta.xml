    <decisions>
        <name>Check_Account</name>
        <label>Check Account</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_account_id_not_null</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_related_account.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_Last_Invoice_Date</targetReference>
            </connector>
            <label>If account id not null</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Date_Period</name>
        <label>Check Date Period</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Copy_2_of_Assign_Opportunity_Type</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Exceeds_24_months</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_related_account.Last_Invoice_Date__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>newBusiness</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Opportunity_Type</targetReference>
            </connector>
            <label>Exceeds 24 months</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Estimating_Tool</name>
        <label>Check Estimating Tool</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Clear_due_date</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Procore</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Estimating_Tool__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Procore</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_procore_due_date</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>Procore</label>
        </rules>
        <rules>
            <name>Excel</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Estimating_Tool__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Excel</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_excel_due_date</targetReference>
            </connector>
            <label>Excel</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Last_Invoice_Date</name>
        <label>Check Last Invoice Date</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Assign_opp_type</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_not_null</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_related_account.Last_Invoice_Date__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_Date_Period</targetReference>
            </connector>
            <label>If not null</label>
        </rules>
    </decisions>
    <decisions>
        <name>Inserted_Updated</name>
        <label>Inserted/Updated</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Updated</defaultConnectorLabel>
        <rules>
            <name>Inserted</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>isNew</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_Estimating_Tool</targetReference>
            </connector>
            <label>Inserted</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>excelDueDate</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate}+3</expression>
    </formulas>
    <formulas>
        <name>isNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>newBusiness</name>
        <dataType>Date</dataType>
        <expression>ADDMONTHS({!$Flow.CurrentDate}, -24)</expression>
    </formulas>
    <formulas>
        <name>procoreDueDate</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate}+10</expression>
    </formulas>
    <interviewLabel>Opportunity Create &amp; Update (Before Flow) {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity Create &amp; Update (Before Flow)</label>
