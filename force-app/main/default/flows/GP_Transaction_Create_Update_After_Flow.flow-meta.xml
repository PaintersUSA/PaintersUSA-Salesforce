            <value>
                <elementReference>$Record.SW_Sales_Rep__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>SW_GP_Transaction__c</object>
        <sortField>SW_Calculation_Date__c</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_GP</name>
        <label>Update GP</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>SW_Carry_Forward__c</field>
            <value>
                <elementReference>frmActualGPAmount</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>SW_Paid_Amount__c</field>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
