    <decisions>
        <name>Check_if_record_is_new_or_not</name>
        <label>Check if record is new or not?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Check_Sobject_Updated</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Record is Updated</defaultConnectorLabel>
        <rules>
            <name>Record_is_New</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>isNew</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_Sobject_New</targetReference>
            </connector>
            <label>Record is New</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Sobject_New</name>
