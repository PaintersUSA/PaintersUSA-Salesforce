            </connector>
            <label>Owner is changed</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_if_Opportunity_Stage_as_closed_or_not</name>
        <label>Check if Opportunity Stage as closed or not?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>loop_over_account_Ownership</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>OppStage_not_Closed</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>loop_over_account_Ownership.SW_Opportunity__r.StageName</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Closed Won</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>loop_over_account_Ownership.SW_Opportunity__r.StageName</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Closed Lost</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Ao_Values</targetReference>
            </connector>
            <label>OppStage not Closed</label>
        </rules>
    </decisions>
