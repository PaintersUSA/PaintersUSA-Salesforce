    {!$Record.SW_Project__r.SW_Total_Cost__c}
)
-
IF(
    ISBLANK({!$Record__Prior.Monthly_Cost__c}),
    0,
    {!$Record__Prior.Monthly_Cost__c}
)
+
IF(
    ISBLANK({!$Record.Monthly_Cost__c}),
    0,
    {!$Record.Monthly_Cost__c}
)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>calculatedTotalRevenue</name>
        <dataType>Currency</dataType>
