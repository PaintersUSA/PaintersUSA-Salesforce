    <formulas>
        <name>calculatedGpAmount</name>
        <dataType>Currency</dataType>
        <expression>IF(
    ISBLANK({!$Record.SW_Project__r.Overall_Gross_Profit__c}),
    0,
    {!$Record.SW_Project__r.SW_Actual_Gross_Profit__c}
)
-
IF(
    ISBLANK({!$Record__Prior.SW_Project__r.SW_Monthly_Gross_Profit__c}),
    0,
    {!$Record__Prior.SW_Project__r.SW_Monthly_Gross_Profit__c}
)
+
IF(
    ISBLANK({!$Record.SW_GP_Amount__c}),
    0,
    {!$Record.SW_GP_Amount__c}
)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>calculatedTotalCost</name>
