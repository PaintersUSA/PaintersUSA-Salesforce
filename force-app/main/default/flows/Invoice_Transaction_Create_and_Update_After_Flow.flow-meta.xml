    0,
    {!$Record__Prior.Monthly_Revenue__c}
)
+
IF(
    ISBLANK({!$Record.Monthly_Revenue__c}),
    0,
    {!$Record.Monthly_Revenue__c}
)</expression>
        <scale>2</scale>
    </formulas>
