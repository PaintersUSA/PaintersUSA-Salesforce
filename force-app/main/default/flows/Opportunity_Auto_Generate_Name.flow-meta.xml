<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Sets Description of Work to Pending when a new Opportunity is created in the Qualification stage and the field is blank.</description>
        <name>Set_Description_of_Work_to_Pending</name>
        <label>Set Description of Work to Pending</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.SW_Description_of_Work__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Pending</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Rebuild_Opportunity_Name</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Assigns the generated Opportunity Name using Opportunity Number, Opportunity Owner initials, Account Name, and Description of Work.

Format:
Opportunity Number-Owner Initials Account Name Description of Work

Example:
261166-00001-KR McNelly Painting Walls</description>
        <name>Set_Opportunity_Name</name>
        <label>Set Opportunity Name</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Name</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>frm_OpportunityName</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <description>Determines whether Description of Work should be set to Pending for newly created Opportunities in the Qualification stage.</description>
        <name>Default_Description_of_Work</name>
        <label>Default Description of Work? `</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Rebuild_Opportunity_Name</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Keep Existing Description</defaultConnectorLabel>
        <rules>
            <name>Set_Description_To_Pending</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>frm_IsNew</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Qualification</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.SW_Description_of_Work__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Description_of_Work_to_Pending</targetReference>
            </connector>
            <label>Set Description To Pending</label>
        </rules>
    </decisions>
    <decisions>
        <description>Determines whether the Opportunity Name should be generated or regenerated because the Opportunity is new or one of the fields used in the naming convention has changed.</description>
        <name>Rebuild_Opportunity_Name</name>
        <label>Rebuild Opportunity Name?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No Name Update Required</defaultConnectorLabel>
        <rules>
            <name>Build_Opportunity_Name</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>frm_RebuildOpportunityName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Opportunity_Owner</targetReference>
            </connector>
            <label>Build Opportunity Name</label>
        </rules>
    </decisions>
    <description>Before-save Opportunity flow that automatically generates the Opportunity Name using Opportunity Number, Opportunity Owner initials, Account Name, and Description of Work. The flow also defaults Description of Work to Pending for new Opportunities in the Qualification stage when the field is blank.</description>
    <environments>Default</environments>
    <formulas>
        <description>Returns True when a new Opportunity is being created.
Used to determine when Description of Work should default to Pending.</description>
        <name>frm_IsNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <description>Builds Opportunity Name using Opportunity Number, Opportunity Owner initials, Account Name, and Description of Work.

Format:
Opportunity Number-Owner Initials Account Name Description of Work

Example:
261166-00001-KR McNelly Painting Walls</description>
        <name>frm_OpportunityName</name>
        <dataType>String</dataType>
        <expression>TRIM(
    {!$Record.SW_Job_Number__c} &amp;
    &quot;-&quot; &amp;
    {!frm_OwnerInitials} &amp;
    &quot; &quot; &amp;
    {!Get_Opportunity_Account.Name} &amp;
    &quot; &quot; &amp;
    {!$Record.SW_Description_of_Work__c}
)</expression>
    </formulas>
    <formulas>
        <description>Generates the Opportunity Owner initials using the first letter of the User First Name and first letter of the User Last Name.</description>
        <name>frm_OwnerInitials</name>
        <dataType>String</dataType>
        <expression>UPPER(
    LEFT({!Get_Opportunity_Owner.FirstName}, 1) &amp;
    LEFT({!Get_Opportunity_Owner.LastName}, 1)
)</expression>
    </formulas>
    <formulas>
        <description>Returns True when the Opportunity is new or when Opportunity Number, Owner, Account, or Description of Work changes and the Opportunity Name should be regenerated.</description>
        <name>frm_RebuildOpportunityName</name>
        <dataType>Boolean</dataType>
        <expression>OR(
    ISNEW(),
    ISCHANGED({!$Record.SW_Job_Number__c}),
    ISCHANGED({!$Record.OwnerId}),
    ISCHANGED({!$Record.AccountId}),
    ISCHANGED({!$Record.SW_Description_of_Work__c})
)</expression>
    </formulas>
    <interviewLabel>Opportunity - Auto Generate Name {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity - Auto Generate Name</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Retrieves the Account associated with the Opportunity so the Account Name can be included in the Opportunity Name.</description>
        <name>Get_Opportunity_Account</name>
        <label>Get Opportunity Account `</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Set_Opportunity_Name</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Retrieves the Opportunity Owner user record so the owner&apos;s first and last initials can be used in the Opportunity Name.</description>
        <name>Get_Opportunity_Owner</name>
        <label>Get Opportunity Owner</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Opportunity_Account</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.OwnerId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>User</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Default_Description_of_Work</targetReference>
        </connector>
        <object>Opportunity</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
