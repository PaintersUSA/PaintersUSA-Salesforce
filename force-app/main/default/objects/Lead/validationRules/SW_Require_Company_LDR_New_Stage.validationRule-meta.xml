<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>SW_Require_Company_LDR_New_Stage</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT($Permission.SW_Bypass_Validation_Rules),
    ISPICKVAL(Status, &quot;New&quot;),
    OR(
        ISBLANK(Company),
        AND(
            ($Permission.ISR),
            ISBLANK(SW_Lead_Development_Representative__c )
        )
    )
)</errorConditionFormula>
    <errorMessage>For Leads in the New stage, Company is required. Lead Development Representative is required for ISR users.</errorMessage>
</ValidationRule>
