<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>SW_Prevent_Lead_Convert_No_OSR</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISCHANGED(Status),
    ISPICKVAL(Status, &quot;Converted&quot;),
    ISBLANK(SW_Lead_Development_Representative__c),
    NOT($Permission.SW_Bypass_Validation_Rules)
)</errorConditionFormula>
    <errorMessage>Please assign the Lead to the relevant OSR before converting.</errorMessage>
</ValidationRule>
