<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>SW_Lead_Source_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND( $Permission.SW_Bypass_Validation_Rules  &lt;&gt; TRUE,
 ISPICKVAL( LeadSource , &quot;&quot;) )</errorConditionFormula>
