<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Prevent_Edit_for_Procore_Estimate</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Opportunity__r.Estimating_Tool__c, &quot;Procore&quot;),
    OR(
        ISCHANGED(Revenue_Amount__c),
        ISCHANGED(Gross_Profit_Dollars__c),
        ISCHANGED(Total_Hours__c)
    )
)</errorConditionFormula>
    <errorMessage>Estimate data cannot be edited when Estimating Tool is Procore.</errorMessage>
</ValidationRule>
